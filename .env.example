# Generated by install.sh in /opt/ezdocker/.env — edit then run: ezdocker restart

# Port of the web panel
EZD_PORT=80
# IP or domain shown in site URLs (can be changed later in the panel)
EZD_PUBLIC_HOST=203.0.113.10
# Public ports given to sites (open this range in your firewall)
EZD_PORT_RANGE=10000-19999

# Super admin created on first start
EZD_ADMIN_USER=admin
EZD_ADMIN_EMAIL=
# Only read on first start (install.sh removes it afterwards)
EZD_ADMIN_PASSWORD=change-me

# Optional
# EZD_BUILDER=buildkit        # or "legacy"
# EZD_BUILD_TIMEOUT=900       # seconds
# EZD_MAX_BUILDS=2            # simultaneous builds
# EZD_SECURE_COOKIES=1        # when the panel is served over HTTPS
# EZD_TRUST_PROXY=1           # when the panel is behind a reverse proxy
