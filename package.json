{
  "name": "ezdocker",
  "version": "1.0.0",
  "description": "Déposez un .zip avec un Dockerfile, EZDocker le met en ligne sur un port automatique.",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dockerode": "^5.0.1",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2"
  }
}
